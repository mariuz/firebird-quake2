{
  "name": "firebird-quake2",
  "version": "0.1.0",
  "private": true,
  "description": "Quake 2 simulated and rendered inside Firebird SQL, running in the browser via Firebird WASM",
  "type": "module",
  "scripts": {
    "fetch-pak": "node scripts/fetch-pak.mjs",
    "build": "node scripts/build.mjs",
    "serve": "node scripts/build.mjs --serve",
    "test": "node scripts/sql-smoke.mjs",
    "test:base2": "node scripts/sql-smoke.mjs demo2",
    "test:monsters": "node scripts/monsters-test.mjs",
    "bench": "node scripts/bench.mjs",
    "screenshots": "node scripts/screenshot.mjs demo1",
    "check": "node scripts/sql-check.mjs",
    "inspect": "node scripts/inspect.mjs",
    "bench:raster": "node scripts/raster-bench.mjs",
    "bench:tic": "node scripts/tic-bench.mjs",
    "bench:calls": "node scripts/call-counts.mjs",
    "bench:ab": "node scripts/ab-bench.mjs",
    "test:save": "node scripts/save-test.mjs",
    "test:base3": "node scripts/sql-smoke.mjs demo3",
    "test:menu": "node scripts/menu-test.mjs",
    "test:painter": "node scripts/painter-test.mjs",
    "test:walkthrough": "node scripts/walkthrough-test.mjs",
    "test:entities": "node scripts/entities-test.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "test:replay": "node scripts/replay-test.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "firebird-wasm": "^0.4.1"
  },
  "devDependencies": {
    "esbuild-wasm": "^0.25.0",
    "playwright": "^1.64.0"
  },
  "engines": {
    "node": ">=20"
  }
}
