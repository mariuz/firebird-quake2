{
  "name": "firebird-quake2",
  "version": "0.1.0",
  "private": true,
  "description": "Quake 2 simulated and rendered inside Firebird SQL, running in the browser via Firebird WASM",
  "type": "module",
  "scripts": {
    "fetch-pak": "node scripts/fetch-pak.mjs",
    "build": "node scripts/build.mjs",
    "serve": "node scripts/build.mjs --serve",
    "test": "node scripts/sql-smoke.mjs",
    "test:base2": "node scripts/sql-smoke.mjs demo2",
    "test:monsters": "node scripts/monsters-test.mjs",
    "bench": "node scripts/bench.mjs",
    "screenshots": "node scripts/screenshot.mjs demo1",
    "check": "node scripts/sql-check.mjs",
    "inspect": "node scripts/inspect.mjs",
    "bench:raster": "node scripts/raster-bench.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "firebird-wasm": "^0.3.0"
  },
  "devDependencies": {
    "esbuild-wasm": "^0.25.0"
  },
  "engines": {
    "node": ">=20"
  }
}
